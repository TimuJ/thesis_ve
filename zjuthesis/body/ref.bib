  url       = {http://arxiv.org/abs/2502.13923},
  doi       = {10.48550/arXiv.2502.13923},
  abstract  = {We introduce Qwen2.5-VL, the latest flagship model of Qwen vision-language series, which demonstrates significant advancements in both foundational capabilities and innovative functionalities. Qwen2.5-VL achieves a major leap forward in understanding and interacting with the world through enhanced visual recognition, precise object localization, robust document parsing, and long-video comprehension. A standout feature of Qwen2.5-VL is its ability to localize objects using bounding boxes or points accurately. It provides robust structured data extraction from invoices, forms, and tables, as well as detailed analysis of charts, diagrams, and layouts. To handle complex inputs, Qwen2.5-VL introduces dynamic resolution processing and absolute time encoding, enabling it to process images of varying sizes and videos of extended durations (up to hours) with second-level event localization. This allows the model to natively perceive spatial scales and temporal dynamics without relying on traditional normalization techniques. By training a native dynamic-resolution Vision Transformer (ViT) from scratch and incorporating Window Attention, we reduce computational overhead while maintaining native resolution. As a result, Qwen2.5-VL excels not only in static image and document understanding but also as an interactive visual agent capable of reasoning, tool usage, and task execution in real-world scenarios such as operating computers and mobile devices. Qwen2.5-VL is available in three sizes, addressing diverse use cases from edge AI to high-performance computing. The flagship Qwen2.5-VL-72B model matches state-of-the-art models like GPT-4o and Claude 3.5 Sonnet, particularly excelling in document and diagram understanding. Additionally, Qwen2.5-VL maintains robust linguistic performance, preserving the core language competencies of the Qwen2.5 LLM.},
  urldate   = {2025-03-05},
  publisher = {arXiv},
  author    = {Bai, Shuai and Chen, Keqin and Liu, Xuejing and Wang, Jialin and Ge, Wenbin and Song, Sibo and Dang, Kai and Wang, Peng and Wang, Shijie and Tang, Jun and Zhong, Humen and Zhu, Yuanzhi and Yang, Mingkun and Li, Zhaohai and Wan, Jianqiang and Wang, Pengfei and Ding, Wei and Fu, Zheren and Xu, Yiheng and Ye, Jiabo and Zhang, Xi and Xie, Tianbao and Cheng, Zesen and Zhang, Hang and Yang, Zhibo and Xu, Haiyang and Lin, Junyang},
  month     = feb,
  year      = {2025},
  note      = {arXiv:2502.13923 [cs]},
  keywords  = {Computer Science - Computer Vision and Pattern Recognition, Computer Science - Computation and Language}
}
@misc{zhang_videollama_2025,
  title      = {{VideoLLaMA} 3: {Frontier} {Multimodal} {Foundation} {Models} for {Image} and {Video} {Understanding}},
  shorttitle = {{VideoLLaMA} 3},
  url        = {http://arxiv.org/abs/2501.13106},
  doi        = {10.48550/arXiv.2501.13106},
  abstract   = {In this paper, we propose VideoLLaMA3, a more advanced multimodal foundation model for image and video understanding. The core design philosophy of VideoLLaMA3 is vision-centric. The meaning of "vision-centric" is two-fold: the vision-centric training paradigm and vision-centric framework design. The key insight of our vision-centric training paradigm is that high-quality image-text data is crucial for both image and video understanding. Instead of preparing massive video-text datasets, we focus on constructing large-scale and high-quality image-text datasets. VideoLLaMA3 has four training stages: 1) Vision Encoder Adaptation, which enables vision encoder to accept images of variable resolutions as input; 2) Vision-Language Alignment, which jointly tunes the vision encoder, projector, and LLM with large-scale image-text data covering multiple types (including scene images, documents, charts) as well as text-only data. 3) Multi-task Fine-tuning, which incorporates image-text SFT data for downstream tasks and video-text data to establish a foundation for video understanding. 4) Video-centric Fine-tuning, which further improves the model's capability in video understanding. As for the framework design, to better capture fine-grained details in images, the pretrained vision encoder is adapted to encode images of varying sizes into vision tokens with corresponding numbers, rather than a fixed number of tokens. For video inputs, we reduce the number of vision tokens according to their similarity so that the representation of videos will be more precise and compact. Benefit from vision-centric designs, VideoLLaMA3 achieves compelling performances in both image and video understanding benchmarks.},
  urldate    = {2025-03-05},
  publisher  = {arXiv},
  author     = {Zhang, Boqiang and Li, Kehan and Cheng, Zesen and Hu, Zhiqiang and Yuan, Yuqian and Chen, Guanzheng and Leng, Sicong and Jiang, Yuming and Zhang, Hang and Li, Xin and Jin, Peng and Zhang, Wenqi and Wang, Fan and Bing, Lidong and Zhao, Deli},
  month      = jan,
  year       = {2025},
  note       = {arXiv:2501.13106 [cs]},
  keywords   = {Computer Science - Computer Vision and Pattern Recognition},
  annote     = {Comment: BZ, KL, ZC, ZH, YY, GC, SL, YJ, HZ, and XL contributed equally to this project. Code: https://github.com/DAMO-NLP-SG/VideoLLaMA3}
}
@misc{lai_lisa_2024,
  title      = {{LISA}: {Reasoning} {Segmentation} via {Large} {Language} {Model}},
  shorttitle = {{LISA}},
  url        = {http://arxiv.org/abs/2308.00692},
  doi        = {10.48550/arXiv.2308.00692},
  abstract   = {Although perception systems have made remarkable advancements in recent years, they still rely on explicit human instruction or pre-defined categories to identify the target objects before executing visual recognition tasks. Such systems cannot actively reason and comprehend implicit user intention. In this work, we propose a new segmentation task -- reasoning segmentation. The task is designed to output a segmentation mask given a complex and implicit query text. Furthermore, we establish a benchmark comprising over one thousand image-instruction-mask data samples, incorporating intricate reasoning and world knowledge for evaluation purposes. Finally, we present LISA: large Language Instructed Segmentation Assistant, which inherits the language generation capabilities of multimodal Large Language Models (LLMs) while also possessing the ability to produce segmentation masks. We expand the original vocabulary with a {\textless}SEG{\textgreater} token and propose the embedding-as-mask paradigm to unlock the segmentation capability. Remarkably, LISA can handle cases involving complex reasoning and world knowledge. Also, it demonstrates robust zero-shot capability when trained exclusively on reasoning-free datasets. In addition, fine-tuning the model with merely 239 reasoning segmentation data samples results in further performance enhancement. Both quantitative and qualitative experiments show our method effectively unlocks new reasoning segmentation capabilities for multimodal LLMs. Code, models, and data are available at https://github.com/dvlab-research/LISA.},
  urldate    = {2025-03-05},
  publisher  = {arXiv},
  author     = {Lai, Xin and Tian, Zhuotao and Chen, Yukang and Li, Yanwei and Yuan, Yuhui and Liu, Shu and Jia, Jiaya},
  month      = may,
  year       = {2024},
  note       = {arXiv:2308.00692 [cs]},
  keywords   = {Computer Science - Computer Vision and Pattern Recognition},
  annote     = {Comment: Code, models, and data are available at https://github.com/dvlab-research/LISA},
  file       = {Preprint PDF:/home/timur/Zotero/storage/MRSMWCHR/Lai и др. - 2024 - LISA Reasoning Segmentation via Large Language Mo.pdf:application/pdf;Snapshot:/home/timur/Zotero/storage/RR74PNHI/2308.html:text/html}
}
@misc{xia_gsva_2024,
  title      = {{GSVA}: {Generalized} {Segmentation} via {Multimodal} {Large} {Language} {Models}},
  shorttitle = {{GSVA}},
  url        = {http://arxiv.org/abs/2312.10103},
  doi        = {10.48550/arXiv.2312.10103},
  abstract   = {Generalized Referring Expression Segmentation (GRES) extends the scope of classic RES to refer to multiple objects in one expression or identify the empty targets absent in the image. GRES poses challenges in modeling the complex spatial relationships of the instances in the image and identifying non-existing referents. Multimodal Large Language Models (MLLMs) have recently shown tremendous progress in these complicated vision-language tasks. Connecting Large Language Models (LLMs) and vision models, MLLMs are proficient in understanding contexts with visual inputs. Among them, LISA, as a representative, adopts a special [SEG] token to prompt a segmentation mask decoder, e.g., SAM, to enable MLLMs in the RES task. However, existing solutions to GRES remain unsatisfactory since current segmentation MLLMs cannot correctly handle the cases where users might reference multiple subjects in a singular prompt or provide descriptions incongruent with any image target. In this paper, we propose Generalized Segmentation Vision Assistant (GSVA) to address this gap. Specifically, GSVA reuses the [SEG] token to prompt the segmentation model towards supporting multiple mask references simultaneously and innovatively learns to generate a [REJ] token to reject the null targets explicitly. Experiments validate GSVA's efficacy in resolving the GRES issue, marking a notable enhancement and setting a new record on the GRES benchmark gRefCOCO dataset. GSVA also proves effective across various classic referring segmentation and comprehension tasks.},
  urldate    = {2025-03-05},
  publisher  = {arXiv},
  author     = {Xia, Zhuofan and Han, Dongchen and Han, Yizeng and Pan, Xuran and Song, Shiji and Huang, Gao},
  month      = mar,
  year       = {2024},
  note       = {arXiv:2312.10103 [cs]},
  keywords   = {Computer Science - Computer Vision and Pattern Recognition},
  annote     = {Comment: Accepted by CVPR2024 (19 pages, 9 figures, 11 tables)},
  file       = {Preprint PDF:/home/timur/Zotero/storage/Q8F3DDGG/Xia и др. - 2024 - GSVA Generalized Segmentation via Multimodal Larg.pdf:application/pdf;Snapshot:/home/timur/Zotero/storage/9UF3KTIL/2312.html:text/html}
}
@misc{gong_vrs_hq_2025,
  title      = {{VRS-HQ}: {Hierarchical} {Temporal} {Tokens} for {High}-{Quality} {Video} {Reasoning} {Segmentation}},
  shorttitle = {{VRS-HQ}},
  url        = {http://arxiv.org/abs/2503.19903},
  doi        = {10.48550/arXiv.2503.19903},
  abstract   = {Video Reasoning Segmentation (VRS) is an emerging challenge that demands models to segment and track objects based on complex textual queries requiring temporal reasoning. While current methods largely adapt image-level techniques to video, they often fail to capture long-range temporal dependencies essential for reasoning. We propose VRS-HQ, a hierarchical temporal token framework that models video at two distinct granularities: frame-level SEG tokens for spatial detail and temporal-level TAK tokens for capturing global temporal semantics. This dual-token design enables the model to leverage MLLM's autoregressive learning for both local and global temporal reasoning. We further introduce Token-Driven Keyframe Selection (TKS), which utilizes SAM 2's occlusion scores to dynamically select the most informative keyframes at inference time. Extensive experiments across multiple VRS benchmarks demonstrate that VRS-HQ achieves state-of-the-art performance, significantly outperforming prior approaches.},
  urldate    = {2025-05-15},
  publisher  = {arXiv},
  author     = {Gong, Jihao and Sun, Chaoyi and Ding, Yuxin and Chen, Zhi and Wang, Jinpeng and Chen, Xiangtai and Lu, Huchuan},
  month      = mar,
  year       = {2025},
  note       = {arXiv:2503.19903 [cs]},
  keywords   = {Computer Science - Computer Vision and Pattern Recognition}
}
@misc{gong_veason_r1_2025,
  title      = {{Veason-R1}: {Reinforcement} {Learning} for {Video} {Reasoning} {Segmentation}},
  shorttitle = {{Veason-R1}},
  url        = {http://arxiv.org/abs/2503.21904},
  doi        = {10.48550/arXiv.2503.21904},
  abstract   = {We present Veason-R1, the first reinforcement learning-based approach to video reasoning segmentation. Building on recent advances in chain-of-thought reasoning for visual understanding, we introduce Group Relative Policy Optimization (GRPO) augmented with CoT initialization to enable structured reasoning trajectories that bridge video-level semantics with frame-level spatial grounding. Our method addresses the unique challenges of video reasoning segmentation by learning to generate coherent reasoning chains that guide object localization across temporal sequences. Experiments on ReasonVOS demonstrate significant improvements over supervised fine-tuning baselines, while exhibiting enhanced robustness to hallucinations. This work establishes reinforcement learning as a promising paradigm for complex video understanding tasks.},
  urldate    = {2025-05-15},
  publisher  = {arXiv},
  author     = {Gong, Jihao and Sun, Chaoyi and Ding, Yuxin and Wang, Jinpeng and Chen, Xiangtai and Lu, Huchuan},
  month      = mar,
  year       = {2025},
  note       = {arXiv:2503.21904 [cs]},
  keywords   = {Computer Science - Computer Vision and Pattern Recognition}
}
@misc{xu_videoseg_r1_2025,
  title      = {{VideoSeg-R1}: {Reasoning} {Segmentation} in {Videos} via {Decoupled} {Architecture} and {Reinforcement} {Learning}},
  shorttitle = {{VideoSeg-R1}},
  url        = {http://arxiv.org/abs/2504.01343},
  doi        = {10.48550/arXiv.2504.01343},
  abstract   = {We introduce VideoSeg-R1, a novel approach for video reasoning segmentation that decouples the task into joint referring image segmentation and video mask propagation. Our framework incorporates a hierarchical text-guided frame sampler that selects representative keyframes based on semantic alignment with the query, and a task difficulty-aware mechanism that adapts the reasoning depth to query complexity. We leverage reinforcement learning with a reward model that jointly considers segmentation quality and reasoning coherence. Experiments on multiple benchmarks demonstrate state-of-the-art performance, particularly on queries requiring complex temporal reasoning.},
  urldate    = {2025-05-15},
  publisher  = {arXiv},
  author     = {Xu, Yiming and Zhang, Lei and Liu, Yu and Wang, Pengfei and Chen, Kai},
  month      = apr,
  year       = {2025},
  note       = {arXiv:2504.01343 [cs]},
  keywords   = {Computer Science - Computer Vision and Pattern Recognition}
}
@misc{han_decaf_2025,
  title      = {{DecAF}: {Training}-{Free} {Decomposed} {Attention} {Fusion} for {Video} {Reasoning} {Segmentation}},
  shorttitle = {{DecAF}},
  url        = {http://arxiv.org/abs/2504.02507},
  doi        = {10.48550/arXiv.2504.02507},
  abstract   = {We present DecAF, a training-free approach for video reasoning segmentation that achieves competitive performance through decomposed attention fusion. Our method extracts attention maps from vision-language models via attention rollout mechanisms and applies contrastive object-background fusion to generate robust localization signals. These attention-derived prompts are then used to guide SAM 2 for mask generation. Despite requiring no model retraining, DecAF achieves results comparable to training-based methods across multiple benchmarks, suggesting that the rich visual-linguistic alignments learned during MLLM pretraining may be sufficient for many video reasoning segmentation scenarios.},
  urldate    = {2025-05-15},
  publisher  = {arXiv},
  author     = {Han, Dongchen and Xia, Zhuofan and Song, Shiji and Huang, Gao},
  month      = apr,
  year       = {2025},
  note       = {arXiv:2504.02507 [cs]},
  keywords   = {Computer Science - Computer Vision and Pattern Recognition}
}
@misc{dang_desa2va_2025,
  title      = {{DeSa2VA}: {Decoupling}-{Enhanced} {Segmentation} {and} {Grounding} with {Visual} {Assistant}},
  shorttitle = {{DeSa2VA}},
  url        = {http://arxiv.org/abs/2504.03360},
  doi        = {10.48550/arXiv.2504.03360},
  abstract   = {We propose DeSa2VA, a decoupling-enhanced approach that addresses the feature entanglement problem in vision-language models for segmentation and grounding tasks. Our method employs linear projection to disentangle hidden states into distinct textual and visual feature subspaces, combined with triple supervision from predicted text masks, visual masks, and ground-truth annotations. This decoupling mechanism enables more precise spatial grounding while preserving the model's reasoning capabilities. Experiments demonstrate state-of-the-art performance across diverse segmentation and grounding benchmarks, including video reasoning segmentation, referring expression segmentation, and visual grounding tasks.},
  urldate    = {2025-05-15},
  publisher  = {arXiv},
  author     = {Dang, Rongyao and Zhang, Kai and Liu, Shilong and Li, Feng and Yang, Jianwei},
  month      = apr,
  year       = {2025},
  note       = {arXiv:2504.03360 [cs]},
  keywords   = {Computer Science - Computer Vision and Pattern Recognition}
}
