  note       = {arXiv:2408.00714 [cs]},
  keywords   = {Computer Science - Artificial Intelligence, Computer Science - Computer Vision and Pattern Recognition, Computer Science - Machine Learning},
  annote     = {Comment: Website: https://ai.meta.com/sam2},
  file       = {Preprint PDF:/home/timur/Zotero/storage/VAGKNFDJ/Ravi и др. - 2024 - SAM 2 Segment Anything in Images and Videos.pdf:application/pdf;Snapshot:/home/timur/Zotero/storage/IAHY2S7S/2408.html:text/html}
